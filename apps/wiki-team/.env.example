# .env.example — wiki-team v2.0 environment variables
#
# Copy to .env and fill in real values before running.
# NEVER commit .env — it is gitignored.
#
# SECURITY: Any value containing "CHANGE_ME_BEFORE_BOOT" will cause the app
# to crash at startup via assertEnv(). This prevents accidental prod deploys
# with default dev credentials.

# ---------------------------------------------------------------------------
# Database (Postgres 16 + pgvector via docker-compose postgres service)

DATABASE_URL=postgres://wiki:devonly@localhost:5432/wiki_team_dev

# ---------------------------------------------------------------------------
# Redis (BullMQ queue backend — docker-compose redis service)

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage (docker-compose minio service)
# Embedding dim: 768 (Gemini text-embedding-004) — do NOT change without
# also updating vector(768) column in notes table and re-migrating.

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wiki
# SECURITY: Replace before any non-local deployment. App rejects literal "CHANGE_ME_BEFORE_BOOT".
MINIO_SECRET_KEY=CHANGE_ME_BEFORE_BOOT
MINIO_BUCKET=wiki-team-files
# Set to "true" for MinIO / local S3-compat; "false" for AWS S3
MINIO_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Gemini embedding API (text-embedding-004, 768-dimensional output)
# Used by apps/wiki-team/storage/embedding.ts embed() helper.
# Get key from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# ---------------------------------------------------------------------------
# App server

PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Auth (P04: Better Auth + MCP token issuance)

# Better Auth: HMAC key for mcp_tokens.prefix_lookup + session signing. Min 32 chars.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_BEFORE_BOOT

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=CHANGE_ME_BEFORE_BOOT
GOOGLE_CLIENT_SECRET=CHANGE_ME_BEFORE_BOOT

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=CHANGE_ME_BEFORE_BOOT
GITHUB_CLIENT_SECRET=CHANGE_ME_BEFORE_BOOT
