# .env.example — wiki-team v2.0 environment variables
#
# Copy to .env and fill in real values before running.
# NEVER commit .env — it is gitignored.
#
# SECURITY: Any value containing "CHANGE_ME_BEFORE_BOOT" will cause the app
# to crash at startup via assertEnv(). This prevents accidental prod deploys
# with default dev credentials.

# ---------------------------------------------------------------------------
# Database (Postgres 16 + pgvector via docker-compose postgres service)

DATABASE_URL=postgres://wiki:devonly@localhost:5432/wiki_team_dev

# ---------------------------------------------------------------------------
# Redis (BullMQ queue backend — docker-compose redis service)

REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# MinIO / S3-compatible object storage (docker-compose minio service)
# Embedding dims: 768 (Google), 1024 (Voyage), 1536 (OpenAI) — routed automatically
# by active provider_settings per workspace (ADR 013 §Vector dimension routing).

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=wiki
# SECURITY: Replace before any non-local deployment. App rejects literal "CHANGE_ME_BEFORE_BOOT".
MINIO_SECRET_KEY=CHANGE_ME_BEFORE_BOOT
MINIO_BUCKET=wiki-team-files
# Set to "true" for MinIO / local S3-compat; "false" for AWS S3
MINIO_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Embedding API keys (P04 / ADR 013)
# GEMINI_API_KEY is no longer used — all provider API keys are stored encrypted
# in the provider_settings table (AES-GCM-256 + HKDF, keyed by BETTER_AUTH_SECRET).
# Configure providers via the admin Settings UI after first boot.
# See: docs/decisions/013-multi-provider-llm.md §Storage

# ---------------------------------------------------------------------------
# App server

PORT=3000
NODE_ENV=development

# WIKI_ENV distinguishes dev / staging / prod more precisely than NODE_ENV alone.
# Staging environments often also set NODE_ENV=production, making them indistinct.
# Values: dev | staging | prod
# Used by: boot-security-check.ts assertProductionSecurityPosture()
WIKI_ENV=dev

# ---------------------------------------------------------------------------
# Auth (P04: Better Auth + MCP token issuance)

# Better Auth: HMAC key for mcp_tokens.prefix_lookup + session signing. Min 32 chars.
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_BEFORE_BOOT

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=CHANGE_ME_BEFORE_BOOT
GOOGLE_CLIENT_SECRET=CHANGE_ME_BEFORE_BOOT

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=CHANGE_ME_BEFORE_BOOT
GITHUB_CLIENT_SECRET=CHANGE_ME_BEFORE_BOOT

# ---------------------------------------------------------------------------
# Wiki-compile worker (P06: BullMQ agent loop)

# Anthropic API key for claude-sonnet-4-5 (wiki-compile agent LLM)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Daily USD cost cap per workspace. Worker refuses new jobs once exceeded.
# Redis key: cost-cap:<workspaceId>:<YYYY-MM-DD> (UTC, auto-resets after 25h)
WIKI_COMPILE_DAILY_USD_CAP=10

# Max concurrent wiki-compile jobs per worker process (BullMQ concurrency).
# Increase with caution — each job holds one Anthropic API connection.
WIKI_COMPILE_CONCURRENCY=3

# ---------------------------------------------------------------------------
# MCP server (apps/wiki-team/mcp-host/server.ts — standalone Bun process)
# Dual-transport: POST /mcp (Streamable HTTP primary) + GET /mcp/sse (SSE legacy fallback)

MCP_PORT=3334

# ---------------------------------------------------------------------------
# HTTP API server (apps/wiki-team/server.ts — Hono on Bun.serve)

API_PORT=3333

# HMAC secret for audit_events.actor_email_hmac (SHA-256).
# NEVER raw email stored in audit table. Generate: openssl rand -hex 32
AUDIT_HMAC_SECRET=CHANGE_ME_BEFORE_BOOT

# ---------------------------------------------------------------------------
# Admin bootstrap (P06 — first-boot only)
#
# Set DEFAULT_ADMIN_EMAIL + DEFAULT_ADMIN_PASSWORD to create the initial admin
# user on first boot. Both vars are deleted / unset after the user is created.
#
# SECURITY requirements:
#   - DEFAULT_ADMIN_PASSWORD: ≥12 chars, entropy ≥2.5 bits/char, no common defaults
#   - In production: use Docker secrets file or K8s secret — NOT raw env vars
#     (see docs/operations.md §Initial admin setup)
#   - Remove both vars from environment after first successful boot
#   - WIKI_ENV=prod + weak password → server refuses to start
#
# First-boot steps:
#   1. Set DEFAULT_ADMIN_EMAIL=admin@yourorg.com
#   2. Set DEFAULT_ADMIN_PASSWORD to a strong password (≥12 chars)
#   3. Start server → admin user created → password cleared from env automatically
#   4. Log in at /signin with email + password
#   5. Remove DEFAULT_ADMIN_EMAIL + DEFAULT_ADMIN_PASSWORD from your secrets config

DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_BEFORE_BOOT

# ---------------------------------------------------------------------------
# Vision captions (P03: image extraction + vision captioning — SEPARATE BullMQ queue)
# VISION_ENABLED_DEFAULT=false — opt-in per workspace via provider_settings capability='vision' row.
# Admin must acknowledge "image content may be sent to {provider}" before enabling.

# Default: false — vision is opt-in; workspace must have a vision provider_settings row.
VISION_ENABLED_DEFAULT=false

# Per-material USD cost cap for vision captioning (default $0.50).
# Images are skipped (status='skipped', skipped_reason='cost_cap_hit') once cap is hit.
# Redis key: vision-material-cost:<materialId> (no TTL — resets on recompile).
VISION_COST_CAP_USD_PER_MATERIAL=0.50

# Max image size in MB to submit for captioning (default 5MB).
# Images exceeding this are stored in material_images with status='skipped'.
IMAGE_MAX_SIZE_MB=5

# Max concurrent vision caption sub-jobs per worker process.
# Vision API calls are I/O-bound; higher concurrency is safe.
VISION_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Observability

# Structured logger level (pino). Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Sentry DSN for error reporting (optional — leave blank/unset to disable)
# Get DSN from https://sentry.io > Project Settings > Client Keys (DSN)
# When unset: Sentry is silently disabled (no runtime cost)
SENTRY_DSN=
